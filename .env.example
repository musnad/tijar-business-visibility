# Copy to .env.local (gitignored)

VITE_SUPABASE_URL=https://ongsfahnfknqelyhuxrt.supabase.co
# Dashboard: Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=

VITE_APP_ENV=development

# Public site URL — required for production deploy & Android APK (no trailing slash)
# VITE_PUBLIC_APP_URL=https://tijar-two.vercel.app

# Server-only — never prefix with VITE_
# SUPABASE_SERVICE_ROLE_KEY=

# NKENNEAi (server-only — NEVER prefix with VITE_; never commit real keys)
# Get a key: https://nkenne.ai → Developer Tools → API Keys
# Used for: Text-to-Text, Text-to-Speech, Speech-to-Text, Speech Translations
# NKENNEAI_API_KEY=your_key_here
# NKENNEAI_BASE_URL=https://developers-api.nkenne.ai
# Optional comma-separated Origins for /api/translate* /api/speak (in addition to VITE_PUBLIC_APP_URL)
# TRANSLATE_ALLOWED_ORIGINS=
